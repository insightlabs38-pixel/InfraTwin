{
  "name": "infratwin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @infratwin/web",
    "build": "npm run build --workspace @infratwin/web",
    "start": "npm run start --workspace @infratwin/web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "benchmark:level2": "node --experimental-strip-types benchmarks/level2-medium.ts",
    "benchmark:level3": "node --experimental-strip-types benchmarks/level3-optimizer.ts",
    "benchmark:scale": "npm run benchmark:scale:engine && npm run benchmark:scale:features && npm run benchmark:scale:browser",
    "test:e2e": "playwright test",
    "benchmark:scale:engine": "node --experimental-strip-types benchmarks/scale.ts",
    "benchmark:scale:browser": "playwright test --config=playwright.scale.config.ts",
    "benchmark:scale:features": "node --experimental-strip-types benchmarks/feature-scale.ts",
    "test:webmcp:native": "WEBMCP_NATIVE=1 playwright test e2e/phase35d-native-webmcp.spec.ts --headed --workers=1 --output=test-results-native --reporter=list",
    "benchmark:level4-design": "node --experimental-strip-types benchmarks/level4-design.ts"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.3",
    "@playwright/test": "1.62.1"
  },
  "engines": {
    "node": ">=22"
  }
}
