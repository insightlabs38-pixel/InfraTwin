{
  "name": "infratwin",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @infratwin/web",
    "build": "npm run build --workspace @infratwin/web",
    "start": "npm run start --workspace @infratwin/web",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "benchmark:level2": "node --experimental-strip-types benchmarks/level2-medium.ts",
    "benchmark:level3": "node --experimental-strip-types benchmarks/level3-optimizer.ts",
    "benchmark:scale": "node --experimental-strip-types benchmarks/scale.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.8.3",
    "@playwright/test": "1.62.1"
  },
  "engines": {
    "node": ">=22"
  }
}
